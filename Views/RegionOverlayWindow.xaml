<Window x:Class="ScreenshotApp.Views.RegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenshotApp.Views"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ShowActivated="True">
  <Grid>
    <Canvas x:Name="Surface" Background="#01000000">
      <Rectangle x:Name="DimTop" Fill="#99000000" IsHitTestVisible="False"/>
      <Rectangle x:Name="DimLeft" Fill="#99000000" IsHitTestVisible="False"/>
      <Rectangle x:Name="DimRight" Fill="#99000000" IsHitTestVisible="False"/>
      <Rectangle x:Name="DimBottom" Fill="#99000000" IsHitTestVisible="False"/>
      <Rectangle x:Name="SelectionBox" Stroke="White" StrokeThickness="2" Fill="#22FFFFFF" IsHitTestVisible="False" Visibility="Collapsed"/>
      <TextBlock x:Name="SizeLabel" Foreground="White" FontWeight="Bold" FontSize="14" IsHitTestVisible="False"/>
    </Canvas>
    <Border x:Name="Toolbar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0"
            Background="#F8FAFC" CornerRadius="10" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
      <StackPanel>
        <local:RecordOptionsBar x:Name="Options"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#475569"/>
          <Button x:Name="OkButton" Content="完成截图" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
          <Button Content="取消" Margin="0" Click="Cancel_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
