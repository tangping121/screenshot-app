<Window x:Class="ScreenshotApp.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
  <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
    <Grid>
      <Image x:Name="Photo" Stretch="Uniform"/>
      <Button Content="×" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="4" Padding="0" FontSize="16" Background="#111827" Foreground="White"
              BorderThickness="0" Click="Close_Click"/>
    </Grid>
  </Border>
</Window>
