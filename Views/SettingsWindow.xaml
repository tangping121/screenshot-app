<Window x:Class="ScreenshotApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
  <StackPanel Margin="18">
    <TextBlock Text="保存目录" FontWeight="SemiBold"/>
    <DockPanel Margin="0,6,0,14">
      <Button DockPanel.Dock="Right" Content="浏览" Click="Browse_Click"/>
      <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
    </DockPanel>

    <TextBlock Text="快捷键" FontWeight="SemiBold"/>
    <TextBlock Text="在输入框里直接按下组合键。每个快捷键都要带 Ctrl、Alt 或 Shift。" Margin="0,4,0,8" Foreground="#64748B" TextWrapping="Wrap"/>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="区域截图" VerticalAlignment="Center" Margin="0,0,0,8"/>
      <TextBox x:Name="RegionShotBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="1" Text="全屏截图" VerticalAlignment="Center" Margin="0,0,0,8"/>
      <TextBox x:Name="FullShotBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="2" Text="区域录像" VerticalAlignment="Center" Margin="0,0,0,8"/>
      <TextBox x:Name="RegionRecordBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="3" Text="停止录像" VerticalAlignment="Center"/>
      <TextBox x:Name="StopRecordBox" Grid.Row="3" Grid.Column="1"/>
    </Grid>

    <TextBlock Text="录像默认" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
      <TextBlock Text="分辨率" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="CapBox" Width="180" Margin="0,0,16,0"/>
      <TextBlock Text="帧率" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="FpsBox" Width="80"/>
    </StackPanel>
    <CheckBox x:Name="SystemBox" Content="默认录系统声音" Margin="0,0,0,6"/>
    <CheckBox x:Name="MicBox" Content="默认录麦克风" Margin="0,0,0,6"/>
    <CheckBox x:Name="CountdownBox" Content="开始前倒计时 3 秒" Margin="0,0,0,6"/>
    <TextBlock x:Name="DeviceText" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,14"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
      <Button Content="取消" IsCancel="True" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
