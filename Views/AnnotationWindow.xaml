<Window x:Class="ScreenshotApp.Views.AnnotationWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标注截图"
        WindowStartupLocation="CenterScreen"
        Background="#E2E8F0">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="PenButton" Content="画笔" Click="Tool_Click" Tag="Pen"/>
          <Button x:Name="ArrowButton" Content="箭头" Click="Tool_Click" Tag="Arrow"/>
          <Button x:Name="RectButton" Content="矩形" Click="Tool_Click" Tag="Rect"/>
          <Button x:Name="TextButton" Content="文字" Click="Tool_Click" Tag="Text"/>
          <Button x:Name="MosaicButton" Content="马赛克" Click="Tool_Click" Tag="Mosaic"/>
          <Button x:Name="ThinButton" Content="细" Click="Thin_Click"/>
          <Button x:Name="ThickButton" Content="粗" Click="Thick_Click"/>
          <Button Width="28" Background="#E23D3D" Click="Color_Click" Tag="#E23D3D"/>
          <Button Width="28" Background="#F2994A" Click="Color_Click" Tag="#F2994A"/>
          <Button Width="28" Background="#F2C94C" Click="Color_Click" Tag="#F2C94C"/>
          <Button Width="28" Background="#27AE60" Click="Color_Click" Tag="#27AE60"/>
          <Button Width="28" Background="#2F80ED" Click="Color_Click" Tag="#2F80ED"/>
          <Button Width="28" Background="White" BorderBrush="#94A3B8" Click="Color_Click" Tag="#FFFFFF"/>
          <Button Width="28" Background="Black" Click="Color_Click" Tag="#111111"/>
          <Button Content="撤销" Click="Undo_Click"/>
          <Button Content="重做" Click="Redo_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Content="复制" Click="Copy_Click"/>
          <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
          <Button Content="贴到桌面" Click="Pin_Click"/>
          <Button Content="关闭" Margin="0" Click="Close_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="#64748B" Text="正在复制到剪贴板…"/>
      </StackPanel>
    </Border>
    <Viewbox Margin="16" Stretch="Uniform">
      <Grid x:Name="Stage" Background="Transparent"
            PreviewMouseLeftButtonDown="Stage_Down"
            PreviewMouseMove="Stage_Move"
            PreviewMouseLeftButtonUp="Stage_Up">
        <Image x:Name="Photo" Stretch="Fill"/>
        <Canvas x:Name="Ink"/>
      </Grid>
    </Viewbox>
  </DockPanel>
</Window>
