<Window x:Class="ScreenshotApp.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图录像"
        Width="820" Height="560"
        MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="截图录像" FontSize="26" FontWeight="SemiBold" Foreground="#0F172A"/>
      <TextBlock Text="关闭窗口后会留在托盘。截图和录像不能同时进行。" Margin="0,4,0,16" Foreground="#64748B"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button x:Name="RegionShotButton" Content="区域截图" Style="{StaticResource PrimaryButton}" Click="RegionShot_Click"/>
        <Button x:Name="FullShotButton" Content="全屏截图" Click="FullShot_Click"/>
        <Button x:Name="RegionRecordButton" Content="区域录像" Click="RegionRecord_Click"/>
        <Button x:Name="FullRecordButton" Content="全屏录像" Click="FullRecord_Click"/>
        <Button x:Name="StopButton" Content="停止录像" Click="Stop_Click" IsEnabled="False"/>
      </StackPanel>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button Content="设置" Click="Settings_Click" DockPanel.Dock="Right"/>
      <Button Content="打开保存目录" Click="OpenFolder_Click" DockPanel.Dock="Right"/>
      <TextBlock x:Name="FolderText" VerticalAlignment="Center" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="14,12,14,8" FontWeight="SemiBold" Text="最近的文件"/>
        <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" Margin="8,0,8,8">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="6,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Foreground="#64748B" Margin="0,2,0,0">
                    <Run Text="{Binding Kind}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding TimeText}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding SizeText}"/>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="打开" Padding="8,4" Click="Open_Click"/>
                  <Button Content="文件夹" Padding="8,4" Click="Reveal_Click"/>
                  <Button Content="复制" Padding="8,4" Click="Copy_Click"/>
                  <Button Content="删除" Padding="8,4" Margin="0" Click="Delete_Click"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
