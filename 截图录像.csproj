<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>ScreenshotApp</RootNamespace>
    <AssemblyName>截图录像</AssemblyName>
    <Version>1.0.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- ScreenRecorderLib 只接受 x86/x64/ARM64。SDK 默认 Platform 是 AnyCPU，这里在它检查之前改成 x64。 -->
  <Target Name="ForceX64Platform" BeforeTargets="PlatformCheck;InjectReference">
    <PropertyGroup>
      <Platform>x64</Platform>
    </PropertyGroup>
  </Target>
</Project>
