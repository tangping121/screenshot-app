<UserControl x:Class="ScreenshotApp.Views.RecordOptionsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="分辨率" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="CapBox" Width="170" Margin="0,0,12,0"/>
      <TextBlock Text="帧率" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="FpsBox" Width="70" Margin="0,0,12,0"/>
      <CheckBox x:Name="SystemBox" Content="系统声音" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <CheckBox x:Name="MicBox" Content="麦克风" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="ReasonText" Margin="0,6,0,0" Foreground="#B45309" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
