<Window x:Class="ScreenshotApp.Views.RecordingBarWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
  <Border Background="#111827" CornerRadius="12" Padding="14,10" MinWidth="280">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click"/>
        <Button x:Name="StopButton" Content="完成" Style="{StaticResource PrimaryButton}" Margin="0" Click="Stop_Click"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock x:Name="TimeText" Text="00:00" Foreground="White" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="HintText" Foreground="#FBBF24" FontSize="12"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
